# Supabase project URL and anon key (Project Settings → API in the Supabase dashboard).
# Safe to expose in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Project Settings → API → service_role).
# Server-side only — never expose in client code or NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=
